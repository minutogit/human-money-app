{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Human Money App",
  "version": "0.5.9",
  "identifier": "human.money.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Human Money App",
        "width": 800,
        "height": 780,
        "minWidth": 640,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../voucher_standards"
    ],
    "fileAssociations": [
      {
        "ext": ["transfer"],
        "name": "HuMoCo Transfer",
        "description": "HuMoCo voucher transfer file",
        "mimeType": "application/vnd.humoco.transfer"
      },
      {
        "ext": ["ask"],
        "name": "HuMoCo Signature Request",
        "description": "HuMoCo voucher signing request file",
        "mimeType": "application/vnd.humoco.ask"
      },
      {
        "ext": ["sig"],
        "name": "HuMoCo Signature",
        "description": "HuMoCo detached signature file",
        "mimeType": "application/vnd.humoco.sig"
      },
      {
        "ext": ["wot"],
        "name": "HuMoCo Trust Package",
        "description": "HuMoCo trust exchange file",
        "mimeType": "application/vnd.humoco.wot"
      },
      {
        "ext": ["standard"],
        "name": "HuMoCo Voucher Standard",
        "description": "HuMoCo voucher standard definition",
        "mimeType": "application/vnd.humoco.standard"
      },
      {
        "ext": ["hmcproof"],
        "name": "HuMoCo Conflict Proof",
        "description": "HuMoCo cryptographic conflict proof",
        "mimeType": "application/vnd.humoco.proof"
      },
      {
        "ext": ["hmcard"],
        "name": "HuMoCo Contact Card",
        "description": "HuMoCo contact card file",
        "mimeType": "application/vnd.humoco.card"
      },
      {
        "ext": ["hmcbackup"],
        "name": "HuMoCo Wallet Backup",
        "description": "HuMoCo encrypted backup archive",
        "mimeType": "application/vnd.humoco.backup"
      },
      {
        "ext": ["humoco"],
        "name": "HuMoCo Package",
        "description": "HuMoCo data file",
        "mimeType": "application/vnd.humoco.package"
      }
    ]
  }
}
