# Disable directory listing
Options -Indexes

# Protect configuration, internal state, rate-limiter, member lists, lock, and temporary files from direct web access
<FilesMatch "^(config\.php|\.state\.php|ratelimit\.bin\.php|members\..*\.php|\.lock|.*\.tmp.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
